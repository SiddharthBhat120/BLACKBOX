# Optional LLM for the postmortem draft. Leave empty to use the evidence-linked template (works offline).
# Free key: https://openrouter.ai/keys  (pick a model ending in ":free")
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Timestamps without a time zone are read in this zone, then stored as UTC.
DEFAULT_TZ=UTC

# Which service calls which (caller:callee, comma separated). Used to weigh trigger candidates.
SERVICE_DEPENDENCIES=gateway:orders,orders:payments
